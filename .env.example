# navigation-ai — environment variables
# Copy this file to .env in the project root and fill in real values (never commit .env).

# ── LLM provider (required) ─────────────────────────────────────────────
# One of: openai | groq | google | ollama
MODEL_PROVIDER=openai

# API key for the chosen provider (only the one matching MODEL_PROVIDER is needed):
OPENAI_API_KEY=sk-your_key_here
# GROQ_API_KEY=gsk_your_key_here          # free tier at https://console.groq.com
# GOOGLE_API_KEY=AIza_your_key_here       # free tier at https://aistudio.google.com

# ── External data APIs ──────────────────────────────────────────────────
# Google Maps — attractions, restaurants and geocoding.
GOOGLE_MAPS_API_KEY=AIza_your_maps_key_here

# Tavily — concert / live-event search. Free tier at https://app.tavily.com
TAVILY_API_KEY=tvly-your_key_here

# Travelpayouts — live flight prices. Optional: without it, flight search
# falls back to the bundled SQLite database (data/travel_agency.db).
TRAVELPAYOUTS_API_KEY=your_key_here
