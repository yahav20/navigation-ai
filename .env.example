# navigation-ai — required environment variables
# Copy this file to .env and fill in real values (never commit .env)

# LLM provider: groq | google | openai | ollama
MODEL_PROVIDER=groq

# Groq API key — get one free at https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# Google Gemini API key (optional — only needed when MODEL_PROVIDER=google)
GOOGLE_API_KEY=AIza_your_key_here

# OpenAI API key (optional — only needed when MODEL_PROVIDER=openai)
OPENAI_API_KEY=sk-your_key_here

# Google Maps API key (needed for geocoding and places features)
GOOGLE_MAPS_API_KEY=AIza_your_maps_key_here
