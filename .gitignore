# Security / API Keys
.env
# atlas-web/.env holds no secrets (just the local server URL) — keep it tracked
# so the web UI works out of the box on a fresh clone.
!atlas-web/.env

# Virtual Environments
taenv/
tavenv/
venv/
.venv/
# .lgenv — dedicated env for the LangGraph dev server (see requirements-server.txt)
.lgenv/

# Python Cache
__pycache__/
*.pyc
*.pyo
*.pyd

# IDEs
.vscode/
.idea/

# LangGraph checkpoints
data/checkpoints.db
data/checkpoints.db-journal
data/checkpoints.db-wal
data/checkpoints.db-shm

package-lock.json
settings.local.json
temp/**

audit.log

# macOS
.DS_Store

# Editor swap/backup files
*.swp
*.swo
*.swn
*~

# Python tool caches
.pytest_cache/
.ruff_cache/

# LangGraph dev-server local state (pickled checkpoints/ops/store)
.langgraph_api/

# Local tooling scaffolding
.air/

# Travel plans written by the save_plan node at runtime (keep the out/ samples)
out/plan-*.md

# Travel-agent prompt dump (debug artifact, only written when ATLAS_DEBUG_TRAVEL_AGENT=1)
out/travel_agent_prompt.json